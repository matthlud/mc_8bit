# Technology-independent Yosys synthesis for the 8-bit CPU.
#
# This netlist is intended for fast simulation and inspection.  The
# technology-mapped SKY130 flow is driven by flow/config.mk and uses the
# OpenROAD-flow-scripts Yosys front-end.

read_verilog -sv rtl/*.sv
hierarchy -check -top cpu

proc
opt
techmap
opt
check

write_verilog -noattr artifacts/cpu_synth.v
stat
show -format dot -prefix artifacts/cpu
